# Create a bot at https://discord.com/developers/applications and paste its
# bot token here. Never commit or share this value.
DISCORD_TOKEN=

# Your Discord server (guild); required. Enable Developer Mode to copy its ID.
DISCORD_GUILD_ID=
# Additional allowed servers. List opt-in-only servers in DEFAULT_OFF_GUILD_IDS.
DISCORD_ADDITIONAL_GUILD_IDS=
DISCORD_DEFAULT_OFF_GUILD_IDS=
BURST_WINDOW_SECONDS=15

# Local paths; relative paths are resolved from this project directory.
DATABASE_PATH=data/translator.sqlite3
LOG_LEVEL=INFO

# Local Ollama service and quality-first translation model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=translategemma:12b
OLLAMA_TIMEOUT_SECONDS=90
